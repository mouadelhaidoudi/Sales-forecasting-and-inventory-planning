# Copy this file to .env for the upcoming Supabase integration.
# The health-only API does not load or use these settings yet.
SUPABASE_URL=https://your-project.supabase.co

# Server-only key from Supabase Settings > API Keys.
# Never copy a real secret key into Angular or commit it to Git.
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
